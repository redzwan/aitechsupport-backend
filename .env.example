# ===== Database (PostgreSQL + pgvector extension) =====
# Run once on the DB:  CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://username:password@localhost:5432/aitechsupport_db

# ===== Security =====
# REQUIRED in production. With DEBUG=False the app refuses to boot if this is
# unset/weak (a predictable key allows JWT forgery). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ===== Chat models (via OpenRouter — one key reaches Claude, GPT, gpt-oss, Mistral, Gemma, ...) =====
# Get a key at https://openrouter.ai/keys . A platform admin can also set/override
# this from the admin panel (stored in the DB), so this is just the bootstrap default.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default model when a bot doesn't specify one (see app/core/models_catalog.py).
DEFAULT_CHAT_MODEL=anthropic/claude-haiku-4.5

# ===== Embeddings =====
# provider: "voyage" (production) | "fake" (deterministic, offline dev/CI only — no real semantics)
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=pa-xxxxxxxx
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# Per-request cap for the embeddings provider (Voyage limits texts/tokens per call).
EMBED_BATCH_SIZE=128

# ===== Chunking / retrieval =====
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
MAX_QUESTION_CHARS=4000
MAX_UPLOAD_BYTES=5242880

# ===== Outbound URL fetch (knowledge crawl; SSRF-guarded, size-capped) =====
URL_FETCH_TIMEOUT=15
URL_FETCH_MAX_REDIRECTS=5
MAX_URL_BYTES=5242880

# ===== WhatsApp channel =====
# provider: "meta" (Cloud API direct) | "360dialog" | "twilio"
WHATSAPP_PROVIDER=meta
# Verify token you set in the Meta webhook config (must match on GET challenge).
WHATSAPP_VERIFY_TOKEN=change-this-verify-token
# App secret used to validate the X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Per-tenant WABA phone_number_id + access token are stored in the DB (Channel),
# NOT here — this file only holds platform-level webhook config.

# ===== Billing (Billplz) =====
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SANDBOX=True
# Kill-switch: payments OFF until the Billplz business account is live (mirrors Realesta).
BILLING_ENABLED=False

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8100
DEBUG=True

# ===== CORS (comma-separated) =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3200,https://aitechsupport.my,https://www.aitechsupport.my

# ===== URLs =====
FRONTEND_URL=https://aitechsupport.my
API_BASE_URL=https://api.aitechsupport.my
