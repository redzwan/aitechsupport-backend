# ===== Database (PostgreSQL + pgvector extension) =====
# Run once on the DB:  CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://username:password@localhost:5432/aitechsupport_db

# ===== Security =====
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ===== Anthropic / Claude (answer generation) =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Cheap/fast default; route hard questions to the fallback model.
ANSWER_MODEL=claude-haiku-4-5-20251001
FALLBACK_MODEL=claude-opus-4-8

# ===== Embeddings (Voyage AI — Anthropic's recommended embedding provider) =====
VOYAGE_API_KEY=pa-xxxxxxxx
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# ===== WhatsApp channel =====
# provider: "meta" (Cloud API direct) | "360dialog" | "twilio"
WHATSAPP_PROVIDER=meta
# Verify token you set in the Meta webhook config (must match on GET challenge).
WHATSAPP_VERIFY_TOKEN=change-this-verify-token
# App secret used to validate the X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Per-tenant WABA phone_number_id + access token are stored in the DB (Channel),
# NOT here — this file only holds platform-level webhook config.

# ===== Billing (Billplz) =====
BILLPLZ_API_KEY=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_SANDBOX=True
# Kill-switch: payments OFF until the Billplz business account is live (mirrors Realesta).
BILLING_ENABLED=False

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8100
DEBUG=True

# ===== CORS (comma-separated) =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3200,https://aitechsupport.my,https://www.aitechsupport.my

# ===== URLs =====
FRONTEND_URL=https://aitechsupport.my
API_BASE_URL=https://api.aitechsupport.my
